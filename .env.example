# ============================================================
# AM4 机队中心环境配置示例
# 复制为 .env 并填入真实值（.env 已被 git 忽略，绝不提交）。
# 面板「设置」页可以按账号覆盖运营参数与自动化开关。
# ============================================================

# ---- AM4 游戏账号（可选）----
# 默认不配置：面板与 /setup 仍可正常启动。
# 需要启动该账号的采集循环时，再设置 AM4_EMAIL / AM4_PASSWORD 两个环境变量。

# ---- 运营参数 ----
# 起飞成本指数（0~200）
AM4_COST_INDEX=200
# 燃油低于该值（Lbs）时跳过需求刷新与自动起飞
AM4_MIN_FUEL=200000
# 低价采购现金保护：采购后保留现金 / 单轮最大支出
AM4_CASH_RESERVE=5000000
AM4_MAX_RESOURCE_SPEND=25000000
AM4_FUEL_BUY_BELOW=500
AM4_CO2_BUY_BELOW=125
# 自动起飞保护：距 A-Check 过近或损坏率过高时不自动起飞
AM4_MIN_A_CHECK_HOURS=5
AM4_MAX_WEAR_FOR_TAKEOFF=80

# ---- 自动化开关（1 开 / 0 关；面板可按账号覆盖）----
AM4_AUTO_MARKETING=1
AM4_AUTO_BUY_FUEL=1
AM4_AUTO_BUY_CO2=1
AM4_AUTO_TAKEOFF=1

# ---- 面板管理员与初始化 ----
# 账号库中尚无管理员时用这两个变量启动自动创建（免 /setup）；
# 用户名规则与 /setup 一致：2~8 位字母/数字，可含空格、_、/，头尾不能有空格
AM4_ADMIN_USERNAME=
AM4_ADMIN_PASSWORD=
# 首次通过 /setup 创建管理员必须提供；留空则网页初始化禁用
AM4_SETUP_TOKEN=

# ---- 服务与安全 ----
# 会话 Cookie 是否仅通过 HTTPS 发送（公网 HTTPS 部署置 1）
AM4_COOKIE_SECURE=0
# 部署在 nginx 等单一可信反代后置 1，按 X-Forwarded-For 还原真实客户端 IP
AM4_TRUST_PROXY=0
# 全局并发循环数上限
AM4_MAX_CONCURRENT_LOOPS=3
# SSE 实时推送连接上限（与 gunicorn --threads 对齐，留出普通请求线程）
AM4_MAX_SSE_CLIENTS=8
# 模板热重载（生产保持 0）
AM4_DEBUG_TEMPLATES=0
# 面板账号库路径（默认 data/panel.db）
# AM4_PANEL_DB=/opt/am4/data/panel.db
# 只读检查：置 1 时不启动后台待办调度
AM4_DISABLE_SCHEDULER=0

# ---- 受保护账号 ----
# 逗号分隔；名单内账号拒绝一切自动化（循环、待办、市场抓取、在线建设/精算），
# 防止与线上正在运营的账号双开或测试误触发
AM4_PROTECTED_ACCOUNTS=
