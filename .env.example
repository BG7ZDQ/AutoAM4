# AM4 账号凭据（复制为 .env 并填入真实值，.env 已被 git 忽略）
# 不设置时采集脚本会拒绝启动，避免凭据泄露进代码/版本库
AM4_EMAIL=your_email@example.com
AM4_PASSWORD=your_password

# 起飞成本指数（0~200，默认 200；可选配置）
AM4_COST_INDEX=200

# 燃油低于该值（Lbs）时跳过需求刷新与自动起飞（默认 200000；可选配置）
AM4_MIN_FUEL=200000

# 玩家保护：低价资源采购仍保留现金，且单轮限制最大采购支出
AM4_CASH_RESERVE=5000000
AM4_MAX_RESOURCE_SPEND=25000000
AM4_FUEL_BUY_BELOW=500
AM4_CO2_BUY_BELOW=125

# 自动起飞保护：距 A-Check 过近或损坏率过高时不自动起飞
AM4_MIN_A_CHECK_HOURS=5
AM4_MAX_WEAR_FOR_TAKEOFF=80

# 操作开关（面板「设置」页可按账号覆盖；采集进程读取这些环境变量）
AM4_AUTO_MARKETING=1
AM4_AUTO_BUY_FUEL=1
AM4_AUTO_BUY_CO2=1
AM4_AUTO_TAKEOFF=1

# 会话 Cookie 是否仅通过 HTTPS 发送（部署到公网置 1）
AM4_COOKIE_SECURE=0

# 面板管理员（可选）：设置后且账号库中尚无管理员时，启动自动创建，
# 无需访问 /setup；已有管理员或留空则忽略
AM4_ADMIN_USERNAME=
AM4_ADMIN_PASSWORD=

# 全局并发循环数上限（默认 3；并发实例各自独立）
AM4_MAX_CONCURRENT_LOOPS=3

# 实时推送（SSE）连接数上限（默认 50）
AM4_MAX_SSE_CLIENTS=50

# 面板账号库路径（默认 data/panel.db；建议放在仅服务用户可读的目录）
# AM4_PANEL_DB=/opt/am4/data/panel.db

# 开发/只读检查：置 1 时不启动后台待办调度
AM4_DISABLE_SCHEDULER=0
