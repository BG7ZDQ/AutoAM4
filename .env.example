# AM4 账号凭据（复制为 .env 并填入真实值，.env 已被 git 忽略）
# 不设置时采集脚本会拒绝启动，避免凭据泄露进代码/版本库
AM4_EMAIL=your_email@example.com
AM4_PASSWORD=your_password

# 起飞成本指数（0~200，默认 200；可选配置）
AM4_COST_INDEX=200

# 燃油低于该值（Lbs）时跳过需求刷新与自动起飞（默认 200000；可选配置）
AM4_MIN_FUEL=200000

# 玩家保护：低价资源采购仍保留现金，且单轮限制最大采购支出
AM4_CASH_RESERVE=5000000
AM4_MAX_RESOURCE_SPEND=25000000
AM4_FUEL_BUY_BELOW=500
AM4_CO2_BUY_BELOW=125

# 自动起飞保护：距 A-Check 过近或损坏率过高时不自动起飞
AM4_MIN_A_CHECK_HOURS=5
AM4_MAX_WEAR_FOR_TAKEOFF=80
