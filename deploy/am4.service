[Unit]
Description=AM4 fleet dashboard and scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=am4
Group=am4
WorkingDirectory=/opt/am4/app
Environment=AM4_PORT=5000
Environment=TEMP=/opt/am4/tmp
Environment=PYTHONUNBUFFERED=1
Environment=AM4_COOKIE_SECURE=1
# 每个 SSE 长连接占用一个 gthread 工作线程（本单元 --threads 8）；
# 预留 2 个线程给普通请求，避免实时流把面板打挂
Environment=AM4_MAX_SSE_CLIENTS=6
# 上游只有本机 nginx 一个可信代理：用 X-Forwarded-For 还原真实客户端 IP，
# 供登录/注册限流按真实来源计数
Environment=AM4_TRUST_PROXY=1
ExecStart=/opt/am4/app/.venv/bin/gunicorn --chdir /opt/am4/app/src --bind 127.0.0.1:5000 --workers 1 --threads 8 --timeout 900 --access-logfile - --error-logfile - server:app
ExecStartPost=/opt/am4/app/.venv/bin/python /opt/am4/app/deploy/start_loop.py
Restart=on-failure
RestartSec=10
TimeoutStartSec=45
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/am4

[Install]
WantedBy=multi-user.target
